# E2E credentials para tests Playwright (Plan 06 de Phase 29).
#
# Copiar a `apps/web/.env.test` (gitignored) y completar el password real.
#
# Wave 0 del Plan 04 prepara el usuario admin via uno de dos approaches:
#   - Approach A (preferido): crear usuario via Supabase MCP / consola
#     con app_metadata.role = 'admin'.
#   - Approach B (fallback offline): correr el seed idempotente desde backend:
#       E2E_SEED=true \
#       E2E_ADMIN_EMAIL=e2e-admin@test.local \
#       E2E_ADMIN_PASSWORD=<password-real> \
#       pnpm --filter @objetiva/backend db:seed:e2e
#
# El usuario es `e2e-admin@test.local` con `app_metadata.role = 'admin'`.
# El runner E2E (Plan 06) usa estas variables para hacer login automatico.

E2E_ADMIN_EMAIL=e2e-admin@test.local
E2E_ADMIN_PASSWORD=replace-me-with-the-password-set-during-wave-0
